# Proveedor de IA (Groq — OpenAI SDK compatible)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# Base de datos
DATABASE_PATH=./data/spa.sqlite

NODE_ENV=development

# Zona horaria (usada por el prompt para la fecha de hoy)
TIMEZONE=America/Mexico_City

# WhatsApp Webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# Administración
ADMIN_TOKEN=

# Servidor
PORT=3000

# Límite de peticiones al demo (por IP)
DEMO_RATE_LIMIT_MAX=20
DEMO_RATE_LIMIT_WINDOW_MS=60000
